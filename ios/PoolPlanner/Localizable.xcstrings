    "Tap the map to measure. Taps snap to pool, lot, structure edges and pins.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la carte pour mesurer. Les points s'aimantent aux bords de la piscine, du terrain, des bâtiments et aux repères."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el mapa para medir. Los puntos se ajustan a los bordes de la piscina, el terreno, las edificaciones y los marcadores."
          }
        }
      }
    },
